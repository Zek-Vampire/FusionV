# FusionV React — environment example.
# Copy to .env only if you need to override a default. Never commit .env.

# Base URL of the Spring Boot API.
# The default is a relative path: in development Vite proxies /api to
# http://localhost:8080 (see vite.config.js), so no CORS change is required.
VITE_API_BASE_URL=/api/v1

# Development proxy target (used by vite.config.js only).
VITE_PROXY_TARGET=http://localhost:8080

# Alternative: call the backend directly instead of through the proxy.
# The origin must then be listed in the backend's CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
