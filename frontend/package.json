{
  "name": "fusionv-frontend-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FusionV React frontend foundation (Vite + Tailwind + React Router + TanStack Query)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
