spring.config.import=optional:file:./.env[.properties]

spring.application.name=fusionv
server.port=${SERVER_PORT:8080}

# ---------- PostgreSQL (the only database used by FusionV) ----------
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/fusionv}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# ---------- JPA / Hibernate ----------
# "update" lets Hibernate create/alter tables for LOCAL development.
# For a controlled setup run database/schema.sql first and start with DDL_AUTO=validate.
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
spring.jpa.show-sql=false
spring.jpa.open-in-view=false
# schema.sql is NOT run by Spring (avoids two schema mechanisms fighting each other)
spring.sql.init.mode=never

# ---------- Multipart upload limits ----------
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB

# ---------- FusionV settings ----------
fusionv.jwt.secret=${JWT_SECRET}
fusionv.jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES:120}
fusionv.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173}
fusionv.upload.dir=${UPLOAD_DIR:uploads}
fusionv.upload.max-size-bytes=10485760
fusionv.notification.threads=2
fusionv.notification.queue-size=100
# optional first administrator (created at startup only when both are set)
fusionv.admin.email=${ADMIN_EMAIL:}
fusionv.admin.password=${ADMIN_PASSWORD:}
# optional CSV feed for hackathons (leave empty to disable)
fusionv.hackathons.csv-path=${HACKATHON_CSV_PATH:}
