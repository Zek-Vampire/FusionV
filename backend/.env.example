# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Spring Boot does NOT read .env by itself: use run-dev.ps1 / run-dev.sh (they load it),
# or set these as real environment variables / IDE run-configuration variables.
DB_URL=jdbc:postgresql://localhost:5432/fusionv
DB_USERNAME=postgres
DB_PASSWORD=change_me
# at least 32 characters, random
JWT_SECRET=change_me_to_a_long_random_string_of_32_plus_chars
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
UPLOAD_DIR=uploads
# optional: creates the first administrator at startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
# optional: path to a hackathon CSV feed
HACKATHON_CSV_PATH=
# validate (tables come from database/init via docker compose, or schema.sql) or update (Hibernate creates tables itself)
DDL_AUTO=validate
